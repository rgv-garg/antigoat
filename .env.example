# Copy to .env and keep ONE block uncommented. NEVER commit .env (it holds keys).

# ---------------- A) Offline mock - no GPU, no key. Tests the plumbing.
LLM_BASE_URL=mock
EMBED_MODEL=hash

# ---------------- B) Hosted NVIDIA models while coding on your laptop
# Copy the exact model id from the model page's Python example on build.nvidia.com
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=nvapi-...your key...
# LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b
# EMBED_MODEL=hash

# ---------------- C) Brev GPU (after scripts/serve_vllm.sh). From a laptop, first run
#                     `brev port-forward antigoat` so localhost:8000 reaches the GPU.
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=nemotron-nano
# EMBED_MODEL=BAAI/bge-m3

# ---------------- Strong-attacker bonus run: attacker on hosted Nemotron 3 Super,
#                  Sahayak stays on Brev. These override the LLM_* values for the attacker only.
# ATTACKER_BASE_URL=https://integrate.api.nvidia.com/v1
# ATTACKER_API_KEY=nvapi-...
# ATTACKER_MODEL=nvidia/nemotron-3-super-120b-a12b   # copy the exact id from build.nvidia.com

# ---------------- Model settings (Step 2 decisions)
SAHAYAK_TEMPERATURE=0
SAHAYAK_MAX_TOKENS=512
SAHAYAK_THINKING=false
ATTACKER_TEMPERATURE=0.7
ATTACKER_MAX_TOKENS=1024
ATTACKER_THINKING=true

# ---------------- How real Sahayak is (llm = model-driven, closer to production)
SAHAYAK_EXTRACT=llm      # llm | off   (off = old tell_fact shortcut)
SAHAYAK_VERIFY=llm       # llm | rules (rules = deterministic regex verifier)

# ---------------- Runner
MAX_WORKERS=32
REQUEST_TIMEOUT=120

# ---------------- Sarvam voice (demo only) - key from sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_SPEAKER=simran_en_customer
